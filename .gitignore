# --- Secrets & local environment --------------------------------------
.env
*.env
!.env.example
.env.bak*

# --- Python ------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Runtime state (mounted into the container, never committed) -------
data/
models/

