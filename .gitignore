/supertonic_*.md
# Voice samples and clone previews (may contain personal recordings)
scripts/voice_samples/*
!scripts/voice_samples/.gitkeep
!scripts/voice_samples/README.md
# Host-specific compose tweaks (VPN network_mode, dev code mounts, ...)
docker-compose.override.yml

