DISCORD_TOKEN=replace-with-discord-bot-token
WHITELIST_USERS=441612025286885397
BOT_CONFIG_PATH=/app/data/config.json
TTS_MAX_TEXT_LENGTH=500
TTS_QUEUE_MAXSIZE=50
TTS_PREROLL_MS=250
TTS_PREROLL_MODE=silence
TTS_PREROLL_VOLUME_DB=-90
TTS_SILENCE_TAIL_MS=200
TTS_CONTINUOUS_STREAM=1
# Stream MiniMax audio chunk-by-chunk so the bot starts talking before the
# whole clip is generated (cuts Time-To-First-Audio ~1.6s -> ~0.5-0.8s).
# Requires TTS_CONTINUOUS_STREAM=1. Set to 0 to revert to the file path.
TTS_STREAMING_ENABLED=1
# Budget (seconds) for the FIRST audio chunk only. If the first chunk does
# not arrive in time the bot falls back to Piper. AFTER the first chunk the
# stream lives as long as needed (long messages are not truncated). Defaults
# to TTS_REQUEST_TIMEOUT when unset.
TTS_STREAM_TTFA_TIMEOUT=2.5
TTS_IDLE_FRAME_MODE=silence
TTS_IDLE_VOLUME_DB=-60
TTS_STREAM_TAIL_MS=200
TTS_MAX_CONTINUOUS_IDLE_SECONDS=900
TTS_IDLE_DISCONNECT_SECONDS=60
TTS_AUTO_CONNECT_ENABLED=1
TTS_AUTO_CONNECT_SUPPRESS_SECONDS=30
TTS_TRIM_SILENCE=1
FFMPEG_LOW_DELAY=1
TTS_MERGE_SHORT_MESSAGES=1
TTS_MERGE_MAX_CHARS=40
TTS_MERGE_WINDOW_MS=900
TTS_MERGE_MAX_PARTS=4
TTS_MERGE_ALGORITHM=legacy
TTS_SELECTIVE_HOLD_ENABLED=1
TTS_SELECTIVE_HOLD_HARD_CAP_MS=1200
TTS_SELECTIVE_HOLD_START_EFFECTIVE_LEN=10
TTS_SELECTIVE_HOLD_START_MIN_WORDS_ALT=2
TTS_SELECTIVE_HOLD_START_MIN_EFFECTIVE_LEN_ALT=6
TTS_SELECTIVE_HOLD_REACTION_PAUSE_MS=5000
TTS_SELECTIVE_HOLD_MAX_PARTS=3
TTS_SELECTIVE_HOLD_MAX_GROUP_EFFECTIVE_LEN=56
TTS_SELECTIVE_HOLD_JOIN_SEPARATOR=", "
TTS_SELECTIVE_HOLD_DROP_URL_ONLY=1
TTS_SELECTIVE_HOLD_DROP_MENTION_ONLY=1
TTS_SELECTIVE_HOLD_LOG_DECISIONS=0
TTS_SELECTIVE_HOLD_ENABLE_ORDER_PRESERVING_FLUSH=1
TTS_QUEUE_PUT_TIMEOUT_MS=500
TTS_DEFAULT_VOICE_PROFILE=piper-ruslan
PIPER_MODEL_PATH=/app/models/ru_RU-ruslan-medium.onnx
PIPER_CONFIG_PATH=/app/models/ru_RU-ruslan-medium.onnx.json
PIPER_SPEAKER=-1
PIPER_LENGTH_SCALE=1.0
VOICE_CONNECT_COOLDOWN_SECONDS=60
LOG_LEVEL=INFO

# ── TTS provider dispatcher (MiniMax cloud + Piper fallback) ────────
# Primary synthesis path. local = Piper ONNX only. minimax = try
# MiniMax first, fall back to Piper on any error (timeout, quota,
# auth, network). Default is local for safe rollout; switch to
# minimax AFTER running scripts/clone_voice.py and copying the
# resulting voice_id into MINIMAX_VOICE_ID below.
TTS_PRIMARY_PROVIDER=local

# Single request timeout for any cloud TTS call. 2.5 sec is a 2x
# safety margin over the measured ~1.2 sec end-to-end on this host.
TTS_REQUEST_TIMEOUT=2.5

# Per-message character cap applied at the enqueue boundary (after
# normalize_for_tts stripping). Default 300 per the spec recommendation:
# protects cloud API quota from accidental walls of text and bounds
# Piper CPU. The legacy TTS_MAX_TEXT_LENGTH (default 500) is still the
# hard ceiling if this is unset.
TTS_MAX_CHARS=300

# Circuit breaker: after N consecutive cloud failures, skip the
# cloud provider entirely for CB_COOLDOWN_SECONDS to avoid piling
# timeouts on top of a degraded network.
CB_FAILURE_THRESHOLD=3
CB_COOLDOWN_SECONDS=60

# ── MiniMax provider (cloud) ─────────────────────────────────────────
# Subscription Key from the MiniMax console (Plus / Token Plan, NOT
# PAYG). Required when TTS_PRIMARY_PROVIDER=minimax. The provider is
# silently disabled (bot runs on Piper) when this is empty.
MINIMAX_API_KEY=

# Optional. Add when the API responds with "invalid api key" — paste
# the GroupId shown next to your subscription key in the console.
MINIMAX_GROUP_ID=

# speech-2.8-turbo is the right pick for realtime Discord playback:
# <250ms TTFA, ~$60/M chars. HD is 2-3x slower and $100/M and the
# quality gain is inaudible after Discord's own lossy re-encode.
MINIMAX_MODEL=speech-2.8-turbo

# Cloned voice_id produced by scripts/clone_voice.py. Required for
# primary=minimax; otherwise the bot logs and falls back to local.
MINIMAX_VOICE_ID=

# Default endpoint. This host routes to the Asian (lb-ali) load
# balancer at ICMP 188ms — measurably faster than api-uw (US-West,
# ICMP 243-262ms + worse jitter). Override only if you move the bot
# to a different region.
MINIMAX_BASE_URL=https://api.minimax.io

MINIMAX_LANGUAGE_BOOST=Russian
MINIMAX_SAMPLE_RATE=32000
MINIMAX_BITRATE=128000
